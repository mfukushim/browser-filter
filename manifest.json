{
  "manifest_version": 3,
  "name": "Ad Filter Replacer",
  "version": "1.0.0",
  "description": "ページ内文字列の置換と画像の空白化を行う拡張",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
