{
  "manifest_version": 3,
  "name": "mi Browser Filter & Morpher",
  "version": "1.0.0",
  "description": "ページ内文字列の置換と画像の空白化を行う拡張",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Filter"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
